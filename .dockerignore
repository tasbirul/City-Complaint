# ============================================================
# .dockerignore — Root (used by docker-compose)
# Excludes everything that no service build context needs.
# ============================================================

# Version control
.git/
.github/
.gitignore

# Infrastructure-as-code (not needed inside any container)
terraform/
ansible/
k8s/

# IDE & OS
.vscode/
.vs/
.idea/
.DS_Store
*.swp

# Secrets
.env
.env.*

# Docs
README.md
docs/

# .NET build output
**/bin/
**/obj/
**/out/
**/TestResults/

# Node
**/node_modules/
**/dist/
**/out-tsc/
**/.angular/

# Logs
**/*.log
