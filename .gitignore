# ============================================================
# .gitignore — City-Complaint project
# ============================================================

# ── Secrets & Environment ────────────────────────────────────
.env
.env.*
!.env.example

# ── macOS ────────────────────────────────────────────────────
.DS_Store

# ── IDE ──────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo

# ── .NET / ASP.NET Core ──────────────────────────────────────
bin/
obj/
out/
TestResults/
*.log

# ── Angular / Node.js ────────────────────────────────────────
node_modules/
dist/
out-tsc/
.angular/
npm-debug.log*
yarn-error.log*

# ── Terraform ────────────────────────────────────────────────
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfplan
*.tfvars
!*.tfvars.example

# ── Ansible ──────────────────────────────────────────────────
ansible/__pycache__/
ansible/**/__pycache__/
*.pyc
.venv/
venv/

# ── Kubernetes ───────────────────────────────────────────────
# Never commit kubeconfig — use KUBECONFIG GitHub Secret instead
.kube/
kubeconfig*

# ── SSH Keys ─────────────────────────────────────────────────
*.pem
*.key
