# ============================================================
# .dockerignore — ASP.NET Core backend service
# Build context: backend/services/<service-name>/
# Dockerfile does: COPY *.csproj → restore → COPY . . → publish
# ============================================================

# .NET build output — never copy these; the build stage produces fresh output
bin/
obj/
out/

# Test results
TestResults/

# Dev-only settings (production uses env vars / K8s secrets)
appsettings.Development.json

# IDE
.vs/
.vscode/
*.user
*.suo

# Docker files (already processed by the daemon — no need inside context)
Dockerfile
.dockerignore

# Logs
*.log
